+/// Height of the ribbon's tab row.
+const RIBBON_TAB_H: f32 = 24.0;
+/// Height of the ribbon's body: one large icon (or two small ones) and the group's name.
+const RIBBON_BODY_H: f32 = 66.0;
+
+/// The Tool Sets as an AutoCAD-style ribbon across the top of the drawing: the same tabs, groups
+/// and tools as the docked palette, laid out in one scrolling row so the drawing keeps the full
+/// width of the screen. Large tools come first; the small ones follow in columns of two. The
+/// chevron at the right (or a click on the active tab) minimizes it to the tab row.
+pub fn ribbon(app: &mut CadApp, ui: &mut egui::Ui) {
+    let t = Tokens::get();
+    let collapsed = app.ui.ribbon_collapsed;
+    let height = if collapsed { RIBBON_TAB_H } else { RIBBON_TAB_H + RIBBON_BODY_H };
+    let mut clicked: Option<&'static str> = None;
+    let mut new_tab: Option<&'static str> = None;
+    let mut toggle_collapse = false;
+    egui::Panel::top("cc_ribbon").exact_size(height).resizable(false).frame(egui::Frame::NONE.fill(t.panel)).show(ui, |ui| {
+        let r = ui.max_rect();
+        let p = ui.painter().clone();
+        // Tab row.
+        p.rect_filled(Rect::from_min_size(r.min, vec2(r.width(), RIBBON_TAB_H)), 0.0, t.chrome);
+        let mut x = r.left();
+        for name in ["Drafting", "Modeling"] {
+            let w = 92.0;
+            let tr = Rect::from_min_size(pos2(x, r.top()), vec2(w, RIBBON_TAB_H));
+            let active = app.ui.toolset_tab == name;
+            let resp = ui.interact(tr, ui.id().with(("ribbon_tab", name)), Sense::click());
+            p.rect_filled(tr, 0.0, if active && !collapsed { t.tab_active } else { t.chrome });
+            p.text(
+                tr.center(),
+                egui::Align2::CENTER_CENTER,
+                crate::i18n::t(name),
+                egui::FontId::proportional(13.0),
+                if active { t.text } else { t.text_dim },
+            );
+            icons::describe_control(ui, &resp, crate::i18n::t(name), Some(active), true);
+            if resp.clicked() {
+                if active && !collapsed {
+                    // Like AutoCAD: the active tab minimizes the ribbon, any other tab opens it.
+                    toggle_collapse = true;
+                } else {
+                    new_tab = Some(if name == "Drafting" { "Drafting" } else { "Modeling" });
+                    if collapsed {
+                        toggle_collapse = true;
+                    }
+                }
+            }
+            x += w;
+        }
+        let cr = Rect::from_center_size(pos2(r.right() - 16.0, r.top() + RIBBON_TAB_H / 2.0), vec2(16.0, 16.0));
+        let cresp = ui.interact(cr.expand(4.0), ui.id().with("ribbon_collapse"), Sense::click());
+        icons::paint(&p, cr, if collapsed { Icon::ChevronDown } else { Icon::ChevronUp }, false);
+        let label = if collapsed { "Expand Ribbon" } else { "Minimize Ribbon" };
+        icons::describe_control(ui, &cresp, label, None, false);
+        let tip = if collapsed { crate::tl!("Expand Ribbon") } else { crate::tl!("Minimize Ribbon") };
+        if cresp.on_hover_text(tip).clicked() {
+            toggle_collapse = true;
+        }
+        if collapsed {
+            return;
+        }
+        // Body: one row of groups that scrolls sideways when it is wider than the screen.
+        let body = Rect::from_min_max(pos2(r.left(), r.top() + RIBBON_TAB_H), r.max);
+        ui.scope_builder(egui::UiBuilder::new().max_rect(body), |ui| {
+            egui::ScrollArea::horizontal()
+                .id_salt("cc_ribbon_scroll")
+                .auto_shrink([false, false])
+                .scroll_bar_visibility(egui::scroll_area::ScrollBarVisibility::AlwaysHidden)
+                .show(ui, |ui| {
+                    ui.spacing_mut().item_spacing = vec2(0.0, 0.0);
+                    let groups: &[(&str, &[Tool], &[Tool])] = if app.ui.toolset_tab == "Drafting" { DRAFTING } else { MODELING };
+                    let hidden = |cmd: &str| app.ui.hidden_tools.iter().any(|h| h == cmd);
+                    ui.horizontal_top(|ui| {
+                        ui.add_space(4.0);
+                        for (name, large, small) in groups {
+                            let large: Vec<Tool> = large.iter().copied().filter(|(_, cmd, _)| !hidden(cmd)).collect();
+                            let small: Vec<Tool> = small.iter().copied().filter(|(_, cmd, _)| !hidden(cmd)).collect();
+                            if large.is_empty() && small.is_empty() {
+                                continue;
+                            }
+                            let group = ui.vertical(|ui| {
+                                ui.add_space(3.0);
+                                ui.horizontal_top(|ui| {
+                                    ui.spacing_mut().item_spacing = vec2(2.0, 0.0);
+                                    for (icon, cmd, tip) in &large {
+                                        ui.add_enabled_ui(command_known(cmd), |ui| {
+                                            if icons::button(ui, *icon, 36.0, tip, false).clicked() {
+                                                clicked = Some(cmd);
+                                            }
+                                        });
+                                    }
+                                    for column in small.chunks(2) {
+                                        ui.vertical(|ui| {
+                                            ui.spacing_mut().item_spacing = vec2(0.0, 2.0);
+                                            for (icon, cmd, tip) in column {
+                                                ui.add_enabled_ui(command_known(cmd), |ui| {
+                                                    if icons::button(ui, *icon, 21.0, tip, false).clicked() {
+                                                        clicked = Some(cmd);
+                                                    }
+                                                });
+                                            }
+                                        });
+                                    }
+                                });
+                                ui.add_space(2.0);
+                                ui.add(
+                                    egui::Label::new(egui::RichText::new(crate::i18n::t(name).to_string()).size(10.5).color(t.text_dim))
+                                        .selectable(false),
+                                );
+                            });
+                            // Divider between groups.
+                            let gr = group.response.rect;
+                            let x = gr.right() + 5.0;
+                            ui.painter().vline(x, (body.top() + 6.0)..=(body.bottom() - 6.0), Stroke::new(1.0, t.border));
+                            ui.add_space(11.0);
+                        }
+                    });
+                });
+        });
+    });
+    if let Some(tab) = new_tab {
+        app.ui.toolset_tab = tab.into();
+    }
+    if toggle_collapse {
+        app.ui.ribbon_collapsed = !app.ui.ribbon_collapsed;
+    }
+    if let Some(c) = clicked {
+        app.cmd.buffer.clear();
+        app.start(c);
+    }
+}
