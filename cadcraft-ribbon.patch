+//! The ribbon lays the Tool Sets across the top of the drawing instead of down its left side:
+//! the same tools, in one row, and the drawing keeps the full width.
+
+use cadcraft_engine::Session;
+use cadcraft_ui_egui::{CadApp, Services};
+use egui::vec2;
+use egui_kittest::Harness;
+use egui_kittest::kittest::Queryable;
+
+fn harness(ribbon: bool) -> Harness<'static, CadApp> {
+    let mut app = CadApp::new(Session::default(), Services::default());
+    app.ui.in_window_menu = false;
+    app.integrated_titlebar = true;
+    app.ui.ribbon = ribbon;
+    let mut harness = Harness::builder().with_size(vec2(1280.0, 760.0)).build_ui_state(
+        |ui, app: &mut CadApp| {
+            app.logic(&ui.ctx().clone());
+            app.ui(ui);
+        },
+        app,
+    );
+    harness.run_steps(6);
+    harness
+}
+
+#[test]
+fn the_ribbon_replaces_the_left_palette() {
+    let harness = harness(true);
+    assert!(harness.query_by_label("Collapse Tool Sets").is_none(), "no docked Tool Sets palette beside the drawing");
+    assert!(harness.query_by_label("Minimize Ribbon").is_some(), "the ribbon is shown");
+    let line = harness.get_by_label("Line");
+    let tab = harness.get_by_label("Drafting");
+    assert!(line.rect().top() >= tab.rect().bottom() - 1.0, "tools sit below the tab row");
+    assert!(line.rect().left() < 200.0, "the first group starts at the left edge");
+    let modify = harness.get_by_label("Move");
+    assert!(modify.rect().left() > line.rect().left(), "groups follow one another along the row");
+    assert!((modify.rect().center().y - line.rect().center().y).abs() < 60.0, "all groups share one band across the top");
+}
+
+#[test]
+fn the_classic_palette_is_unchanged_without_the_ribbon() {
+    let harness = harness(false);
+    assert!(harness.query_by_label("Collapse Tool Sets").is_some());
+    assert!(harness.query_by_label("Minimize Ribbon").is_none());
+}
+
+#[test]
+fn a_ribbon_tool_starts_its_command() {
+    let mut harness = harness(true);
+    harness.get_by_label("Circle").click();
+    harness.run_steps(4);
+    assert!(harness.state().session.prompting(), "clicking Circle starts CIRCLE, which now asks for its centre");
+}
+
+#[test]
+fn the_ribbon_minimizes_to_its_tabs_and_comes_back() {
+    let mut harness = harness(true);
+    let full = harness.get_by_label("Line").rect().top();
+    harness.get_by_label("Minimize Ribbon").click();
+    harness.run_steps(4);
+    assert!(harness.state().ui.ribbon_collapsed);
+    assert!(harness.query_by_label("Line").is_none(), "only the tab row is left");
+    harness.get_by_label("Modeling").click();
+    harness.run_steps(4);
+    assert!(!harness.state().ui.ribbon_collapsed, "a tab opens the ribbon again");
+    assert_eq!(harness.state().ui.toolset_tab, "Modeling");
+    harness.get_by_label("Drafting").click();
+    harness.run_steps(4);
+    assert!(harness.get_by_label("Line").rect().top() - full < 1.0);
+}
+
+#[test]
+fn window_tool_sets_hides_and_shows_the_ribbon() {
+    let mut harness = harness(true);
+    harness.state_mut().run("ui.toggle.toolsets", serde_json::json!({})).ok();
+    harness.run_steps(4);
+    assert!(!harness.state().ui.show_toolsets);
+    assert!(harness.query_by_label("Minimize Ribbon").is_none());
+    assert!(harness.query_by_label("Expand Tool Sets").is_none(), "no left strip with the ribbon either");
+    harness.state_mut().run("ui.toggle.toolsets", serde_json::json!({"on": true})).ok();
+    harness.run_steps(4);
+    assert!(harness.query_by_label("Minimize Ribbon").is_some());
+}
